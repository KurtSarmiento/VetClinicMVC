@model VetClinicMVC.ViewModels.PetCreateViewModel
@{
    ViewData["Title"] = "Add New Pet";
}

<h2>Add New Pet</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    @if (!User.IsInRole("Client"))
    {
        <div class="mb-3">
            <label class="form-label">Client (Owner) <span class="text-danger">*</span></label>
            <select asp-for="ClientId" class="form-select" required>
                <option value="">-- Select Owner --</option>
                @foreach (var c in ViewBag.Clients as IEnumerable<VetClinicMVC.Models.Client> ?? Enumerable.Empty<VetClinicMVC.Models.Client>())
                {
                    <option value="@c.ClientId" selected="@(Model.ClientId == c.ClientId)">@c.FirstName @c.LastName</option>
                }
            </select>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="ClientId" value="@ViewBag.ClientId" />
        <div class="alert alert-info">This pet will be registered under <strong>@ViewBag.ClientName</strong></div>
    }

    <div class="row">
        <div class="col-md-6">
            <label class="form-label">Pet Name <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">Species <span class="text-danger">*</span></label>
            <select asp-for="SpeciesId" class="form-select" required>
                <option value="">-- Select Species --</option>
                @foreach (var s in ViewBag.Species as IEnumerable<VetClinicMVC.Models.Species> ?? Enumerable.Empty<VetClinicMVC.Models.Species>())
                {
                    <option value="@s.SpeciesId">@s.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <label class="form-label">Breed</label>
            <select asp-for="BreedId" id="breedSelect" class="form-select">
                <option value="">-- Select Species First --</option>
            </select>
            <span asp-validation-for="BreedId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Gender</label>
            <select asp-for="Gender" class="form-select">
                <option value="">-- Select --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Unknown">Unknown</option>
            </select>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-6">
            <label class="form-label">Birth Date</label>
            <input asp-for="BirthDate" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Weight (kg)</label>
            <input asp-for="Weight" class="form-control" type="number" step="0.01" min="0.1" />
        </div>
    </div>

    <div class="mt-3">
        <label class="form-label">Color</label>
        <input asp-for="Color" class="form-control" />
    </div>

    <div class="mt-3">
        <label class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Pet</button>
        <a href="@(User.IsInRole("Client") ? "/ClientPortal/MyPets" : "/Pet")" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // This triggers whenever the Species dropdown changes
            $('#SpeciesId').change(function () {
                var speciesId = $(this).val();
                var breedSelect = $('#breedSelect');

                // Clear current options
                breedSelect.empty();
                breedSelect.append('<option value="">-- Loading Breeds... --</option>');

                if (speciesId) {
                    $.getJSON('@Url.Action("GetBreedsBySpecies", "Pet")', { speciesId: speciesId }, function (data) {
                        breedSelect.empty();
                        breedSelect.append('<option value="">-- Select Breed --</option>');

                        // Loop through the JSON data we got from the controller
                        $.each(data, function (i, item) {
                            breedSelect.append($('<option>', {
                                value: item.breedId,
                                text: item.name
                            }));
                        });
                    });
                } else {
                    breedSelect.empty();
                    breedSelect.append('<option value="">-- Select Species First --</option>');
                }
            });
        });
    </script>
}
