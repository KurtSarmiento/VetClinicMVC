@model IEnumerable<VetClinicMVC.Models.Pet>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>Pet Name</th>
            <th>Owner</th>
            <th>Species</th>
            <th>Breed</th>
            <th>Gender</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.Client != null ? $"{item.Client.FirstName} {item.Client.LastName}" : "N/A")</td>
                <td>@item.Species?.Name</td>
                <td>@item.Breed?.Name</td>
                <td>@item.Gender</td>
                <td>
                    @{
                        var age = DateTime.Today.Year - (item.BirthDate?.Year ?? DateTime.Today.Year);
                        @age @(age == 1 ? "year" : "years")
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PetId" class="btn btn-info btn-sm">View</a>
                    <a asp-action="Edit" asp-route-id="@item.PetId" class="btn btn-warning btn-sm">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>