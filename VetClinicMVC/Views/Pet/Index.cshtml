@model IEnumerable<VetClinicMVC.Models.Pet>

@{
    ViewData["Title"] = "Pets";
}

<h2 class="mb-4">🐾 All Pets</h2>

<div class="mb-3">
    <a href="/Pet/Create" class="btn btn-success">+ Add New Pet</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Pet Name</th>
            <th>Owner</th>
            <th>Species</th>
            <th>Breed</th>
            <th>Gender</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pet in Model)
        {
            <tr>
                <td>@pet.Name</td>
                <td>@pet.Client?.FirstName @pet.Client?.LastName</td>
                <td>@pet.Species?.Name</td>
                <td>@pet.Breed?.Name</td>
                <td>@pet.Gender</td>
                <td>
                    @(pet.BirthDate.HasValue ?
                        (DateTime.UtcNow.Year - pet.BirthDate.Value.Year) + " years" : "-")
                </td>
                <td>
                    <a href="/Pet/Details/@pet.PetId" class="btn btn-info btn-sm">View</a>
                    <a href="/Pet/Edit/@pet.PetId" class="btn btn-warning btn-sm">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>