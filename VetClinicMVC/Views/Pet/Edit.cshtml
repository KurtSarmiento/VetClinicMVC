@model VetClinicMVC.Models.Pet
@{
    ViewData["Title"] = "Edit Pet";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Edit Pet</h2>
    <a asp-action="Details" asp-route-id="@Model.PetId" class="btn btn-outline-secondary">Back</a>
</div>

<div class="card shadow-sm app-card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PetId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ClientId" class="form-label fw-semibold">Owner</label>
                    <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Pet Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="SpeciesId" class="form-label fw-semibold">Species</label>
                    <select asp-for="SpeciesId" class="form-select" asp-items="ViewBag.Species"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BreedId" class="form-label fw-semibold">Breed</label>
                    <select asp-for="BreedId" class="form-select" asp-items="ViewBag.Breeds">
                        <option value="">No breed selected</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Gender" class="form-label fw-semibold"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">Unknown</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="BirthDate" class="form-label fw-semibold"></label>
                    <input asp-for="BirthDate" class="form-control" type="date" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Weight" class="form-label fw-semibold">Weight (kg)</label>
                    <input asp-for="Weight" class="form-control" type="number" step="0.01" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Color" class="form-label fw-semibold"></label>
                    <input asp-for="Color" class="form-control" />
                </div>
                <div class="col-md-6 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsNeutered" class="form-check-input" />
                        <label asp-for="IsNeutered" class="form-check-label">Neutered / Spayed</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-semibold"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@Model.PetId" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Pet</button>
            </div>
        </form>
    </div>
</div>
