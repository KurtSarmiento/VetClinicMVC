@model VetClinicMVC.Models.Pet
@{
    ViewData["Title"] = "Edit Pet";
}

<h2>Edit Pet Information</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="PetId" />

    <div class="mb-3">
        <label class="form-label">Client (Owner)</label>
        <select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>" required>
        </select>
    </div>

    <div class="row">
        <div class="col-md-6">
            <label class="form-label">Pet Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="col-md-6">
            <label class="form-label">Species</label>
            <input asp-for="SpeciesId" class="form-control" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-4">
            <label class="form-label">Breed</label>
            <input asp-for="BreedId" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Gender</label>
            <select asp-for="Gender" class="form-select">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Unknown">Unknown</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Birth Date</label>
            <input asp-for="BirthDate" class="form-control" type="date" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-4">
            <label class="form-label">Weight (kg)</label>
            <input asp-for="Weight" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Color</label>
            <input asp-for="Color" class="form-control" />
        </div>
    </div>

    <div class="form-check mt-3">
        <input asp-for="IsNeutered" class="form-check-input" />
        <label asp-for="IsNeutered" class="form-check-label">Neutered / Spayed</label>
    </div>

    <div class="mt-3">
        <label class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Update Pet</button>
        <a href="/Pet" class="btn btn-secondary">Cancel</a>
    </div>
</form>