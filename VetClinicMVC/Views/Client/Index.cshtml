@model IEnumerable<VetClinicMVC.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Clients</h2>
        <p class="text-muted mb-0">Pet owner profiles, contact details, and registered patients.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Client</a>
</div>

<div class="card shadow-sm app-card mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Search by name or email" value="@ViewBag.Search" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
</div>

<div class="card shadow-sm app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th>Pets</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td class="fw-semibold">@client.FirstName @client.LastName</td>
                        <td>@client.Email</td>
                        <td>@client.Phone</td>
                        <td>@client.City</td>
                        <td><span class="badge rounded-pill bg-primary">@(client.Pets?.Count ?? 0)</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@client.ClientId" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@client.ClientId" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
