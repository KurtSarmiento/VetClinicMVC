@model IEnumerable<VetClinicMVC.Models.Staff>
@{
    ViewData["Title"] = "Staff Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Staff Members</h2>
        <p class="text-muted mb-0">Manage active veterinarians, receptionists, and clinic staff.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Staff</a>
</div>

<div class="card shadow-sm app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Specialization</th>
                    <th>Phone</th>
                    <th>Hire Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td class="fw-semibold">@staff.FirstName @staff.LastName</td>
                        <td><span class="badge bg-primary">@staff.Role</span></td>
                        <td>@(string.IsNullOrWhiteSpace(staff.Specialization) ? "General" : staff.Specialization)</td>
                        <td>@staff.Phone</td>
                        <td>@staff.HireDate?.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@staff.StaffId" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@staff.StaffId" class="btn btn-sm btn-outline-warning">Edit</a>
                            <form asp-action="Deactivate" asp-route-id="@staff.StaffId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                            </form>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">No active staff members found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
