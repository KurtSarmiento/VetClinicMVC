@model VetClinicMVC.Models.Staff

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="FirstName" class="form-label fw-semibold"></label>
        <input asp-for="FirstName" class="form-control" required />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="LastName" class="form-label fw-semibold"></label>
        <input asp-for="LastName" class="form-control" required />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Role" class="form-label fw-semibold"></label>
        <select asp-for="Role" class="form-select" required>
            <option value="">Select role</option>
            <option value="Veterinarian">Veterinarian</option>
            <option value="Receptionist">Receptionist</option>
            <option value="Admin">Admin</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Specialization" class="form-label fw-semibold"></label>
        <input asp-for="Specialization" class="form-control" placeholder="General, Surgery, Dentistry" />
        <span asp-validation-for="Specialization" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="LicenseNumber" class="form-label fw-semibold"></label>
        <input asp-for="LicenseNumber" class="form-control" />
        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Phone" class="form-label fw-semibold"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="HireDate" class="form-label fw-semibold"></label>
        <input asp-for="HireDate" class="form-control" type="date" />
        <span asp-validation-for="HireDate" class="text-danger"></span>
    </div>
</div>

<div class="form-check">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Active staff member</label>
</div>
