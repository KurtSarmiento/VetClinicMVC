@model IEnumerable<VetClinicMVC.Models.Appointment>
@{
    ViewData["Title"] = "Staff Appointment Queue";
    var selectedStatus = (string?)ViewBag.Status ?? "All";
    var selectedDate = (string?)ViewBag.Date;
    var statusOptions = new[] { "All", "Pending", "Confirmed", "Completed", "Cancelled" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Staff Appointment Queue</h2>
        <p class="text-muted mb-0">Review requests, confirm visits, and start check-ins from one place.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Dashboard</a>
        <a asp-controller="Visit" asp-action="Index" class="btn btn-outline-primary">Medical Records</a>
    </div>
</div>

<div class="card shadow-sm app-card mb-4">
    <div class="card-body">
        <form asp-action="ManageAppointments" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Status</label>
                <select name="status" class="form-select">
                    @foreach (var option in statusOptions)
                    {
                        <option value="@option" selected="@(selectedStatus == option)">@option</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Date</label>
                <input type="date" name="date" value="@selectedDate" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Apply Filters</button>
                <a asp-action="ManageAppointments" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date & Time</th>
                    <th>Patient</th>
                    <th>Owner</th>
                    <th>Veterinarian</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var displayStatus = item.Status == "Scheduled" ? "Pending" : item.Status;
                    var statusClass = displayStatus switch
                    {
                        "Pending" => "bg-primary",
                        "Confirmed" => "bg-primary",
                        "Completed" => "bg-primary",
                        "Cancelled" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <tr>
                        <td>@item.AppointmentDate.ToString("MMM dd, yyyy h:mm tt")</td>
                        <td>
                            <div class="fw-semibold">@item.Pet?.Name</div>
                            <div class="text-muted small">#@item.PetId</div>
                        </td>
                        <td>
                            <div>@item.Client?.FirstName @item.Client?.LastName</div>
                            <div class="text-muted small">@item.Client?.Phone</div>
                        </td>
                        <td>Dr. @item.Staff?.FirstName @item.Staff?.LastName</td>
                        <td class="text-wrap" style="max-width: 220px;">@item.Reason</td>
                        <td><span class="badge @statusClass">@displayStatus</span></td>
                        <td class="text-end">
                            <div class="appointment-actions">
                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-outline-primary">View</a>

                                @if (item.Status == "Pending" || item.Status == "Scheduled")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.AppointmentId" />
                                        <input type="hidden" name="status" value="Confirmed" />
                                        <button type="submit" class="btn btn-sm btn-primary">Confirm</button>
                                    </form>
                                }

                                @if (item.Status == "Confirmed")
                                {
                                    <a asp-action="CheckIn" asp-route-id="@item.AppointmentId" class="btn btn-sm btn-primary">Check-in</a>
                                }

                                @if (item.Status == "Pending" || item.Status == "Scheduled" || item.Status == "Confirmed")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.AppointmentId" />
                                        <input type="hidden" name="status" value="Cancelled" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">No appointments match the selected filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
