@model VetClinicMVC.Models.Staff
@{
    ViewData["Title"] = "Staff Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@Model.FirstName @Model.LastName</h2>
        <p class="text-muted mb-0">@Model.Role</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.StaffId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card shadow-sm app-card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Role</dt>
            <dd class="col-sm-9">@Model.Role</dd>

            <dt class="col-sm-3">Specialization</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Specialization) ? "General" : Model.Specialization)</dd>

            <dt class="col-sm-3">License Number</dt>
            <dd class="col-sm-9">@Model.LicenseNumber</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>

            <dt class="col-sm-3">Hire Date</dt>
            <dd class="col-sm-9">@Model.HireDate?.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Active" : "Inactive")</dd>
        </dl>
    </div>
</div>
