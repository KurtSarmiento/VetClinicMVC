@model VetClinicMVC.Models.Medication

<div class="container mt-4">
    <div class="card shadow col-md-8 mx-auto">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add New Medication</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">Brand Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Biogesic" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="GenericName" class="form-label">Generic Name</label>
                        <input asp-for="GenericName" class="form-control" placeholder="e.g. Paracetamol" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Manufacturer" class="form-label">Manufacturer</label>
                        <input asp-for="Manufacturer" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Unit" class="form-label">Unit (e.g. Tablet, Bottle)</label>
                        <input asp-for="Unit" class="form-control" placeholder="Tablet" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="UnitPrice" class="form-label">Unit Price (₱)</label>
                        <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="StockQuantity" class="form-label">Initial Stock</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ReorderLevel" class="form-label">Reorder Level</label>
                        <input asp-for="ReorderLevel" type="number" class="form-control" placeholder="Alert at..." />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                        <input asp-for="ExpiryDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3 pt-4">
                        <div class="form-check mt-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                            <label class="form-check-label">Available for Sale</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <button type="submit" class="btn btn-success px-5">Save Medication</button>
                </div>
            </form>
        </div>
    </div>
</div>