@model VetClinicMVC.Models.Visit
@{
    ViewData["Title"] = "Record New Visit";
}

<h2>Record New Visit</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Pet</label>
        <select asp-for="PetId" class="form-select" required>
            <option value="">-- Select Pet --</option>
            @foreach (var pet in ViewBag.Pets)
            {
                <option value="@pet.PetId">@pet.Name (@pet.Client.FirstName @pet.Client.LastName)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Chief Complaint</label>
        <textarea asp-for="ChiefComplaint" class="form-control" rows="2" required></textarea>
    </div>

    <div class="row">
        <div class="col-md-6">
            <label class="form-label">Diagnosis</label>
            <textarea asp-for="Diagnosis" class="form-control" rows="3"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label">Treatment</label>
            <textarea asp-for="Treatment" class="form-control" rows="3"></textarea>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-4">
            <label class="form-label">Weight (kg)</label>
            <input asp-for="Weight" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Temperature (°C)</label>
            <input asp-for="Temperature" class="form-control" type="number" step="0.1" />
        </div>
    </div>

    <div class="mt-3">
        <label class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save Visit</button>
        <a href="/Visit" class="btn btn-secondary">Cancel</a>
    </div>
</form>