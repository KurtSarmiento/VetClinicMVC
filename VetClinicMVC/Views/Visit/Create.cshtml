@model VetClinicMVC.Models.Visit

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4>📋 New Medical Examination</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <input type="hidden" asp-for="AppointmentId" />
                <input type="hidden" asp-for="PetId" />
                <input type="hidden" asp-for="StaffId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Weight (kg)</label>
                        <input asp-for="Weight" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Temperature (°C)</label>
                        <input asp-for="Temperature" class="form-control" type="number" step="0.1" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Chief Complaint</label>
                    <input asp-for="ChiefComplaint" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Diagnosis</label>
                    <textarea asp-for="Diagnosis" class="form-control" rows="3" required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Treatment Plan</label>
                    <textarea asp-for="Treatment" class="form-control" rows="3" required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Clinical Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Appointment" asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5">Save Medical Record</button>
                </div>
            </form>
        </div>
    </div>
</div>