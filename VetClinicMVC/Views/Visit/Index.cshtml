@model IEnumerable<VetClinicMVC.Models.Visit>
@{
    ViewData["Title"] = "Medical Records";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="mb-1">Medical Records</h2>
        <p class="text-muted mb-0">Completed visits, diagnoses, treatment plans, and follow-up notes.</p>
    </div>
    <a asp-controller="Staff" asp-action="ManageAppointments" class="btn btn-primary">Create From Appointment</a>
</div>

<div class="card shadow-sm app-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Pet</th>
                    <th>Veterinarian</th>
                    <th>Complaint</th>
                    <th>Diagnosis</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var visit in Model)
                {
                    <tr>
                        <td>@visit.VisitDate?.ToString("MMM dd, yyyy h:mm tt")</td>
                        <td class="fw-semibold">@visit.Pet?.Name</td>
                        <td>Dr. @visit.Staff?.FirstName @visit.Staff?.LastName</td>
                        <td>@visit.ChiefComplaint</td>
                        <td>@(string.IsNullOrWhiteSpace(visit.Diagnosis) ? "" : visit.Diagnosis.Substring(0, Math.Min(60, visit.Diagnosis.Length)))</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@visit.VisitId" class="btn btn-sm btn-outline-primary">View</a>
                            <a asp-action="Edit" asp-route-id="@visit.VisitId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@visit.VisitId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">No medical records yet. Complete a staff check-in to create one.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
