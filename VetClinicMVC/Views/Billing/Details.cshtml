@model VetClinicMVC.Models.Invoice
@{
    ViewData["Title"] = "Bill Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Bill @Model.InvoiceNumber</h2>
        <p class="text-muted mb-0">@Model.Client?.FirstName @Model.Client?.LastName</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm app-card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Issue Date</dt>
                    <dd class="col-sm-8">@Model.IssueDate?.ToString("MMM dd, yyyy")</dd>
                    <dt class="col-sm-4">Due Date</dt>
                    <dd class="col-sm-8">@Model.DueDate?.ToString("MMM dd, yyyy")</dd>
                    <dt class="col-sm-4">Subtotal</dt>
                    <dd class="col-sm-8">₱@Model.Subtotal.ToString("N2")</dd>
                    <dt class="col-sm-4">Tax</dt>
                    <dd class="col-sm-8">₱@((Model.TaxAmount ?? 0).ToString("N2"))</dd>
                    <dt class="col-sm-4">Total</dt>
                    <dd class="col-sm-8 fw-bold">₱@Model.TotalAmount.ToString("N2")</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8"><span class="badge bg-primary">@Model.Status</span></dd>
                    <dt class="col-sm-4">Notes</dt>
                    <dd class="col-sm-8">@Model.Notes</dd>
                </dl>
            </div>
        </div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-lg-5">
            <div class="card shadow-sm app-card">
                <div class="card-body">
                    <h5 class="mb-3">Record Payment</h5>
                    <form asp-action="ProcessPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Amount</label>
                            <input type="number" name="amount" value="@Model.TotalAmount" class="form-control" step="0.01" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Method</label>
                            <select name="method" class="form-select">
                                <option>Cash</option>
                                <option>Card</option>
                                <option>GCash</option>
                                <option>Bank Transfer</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Mark as Paid</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
