@model IEnumerable<VetClinicMVC.Models.Invoice>
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Billing & Invoices</h4>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Client</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.InvoiceNumber</td>
                            <td>@item.Client?.FirstName @item.Client?.LastName</td>
                            <td>₱@item.TotalAmount</td>
                            <td>
                                <span class="badge @(item.Status == "Paid" ? "bg-success" : "bg-warning")">@item.Status</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.InvoiceId" class="btn btn-sm btn-outline-primary">Details/Pay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>