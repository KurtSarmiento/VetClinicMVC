@model VetClinicMVC.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">📅 Schedule an Appointment</h4>
        </div>
        <div class="card-body">
            <form asp-action="Book" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Select Pet</label>
                        <select asp-for="PetId" class="form-select" required>
                            <option value="">-- Choose your pet --</option>
                            @if (ViewBag.MyPets != null)
                            {
                                foreach (var pet in ViewBag.MyPets)
                                {
                                    <option value="@pet.PetId">@pet.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="PetId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Preferred Veterinarian</label>
                        <select asp-for="StaffId" class="form-select" required>
                            <option value="">-- Select a Vet --</option>
                            @foreach (var staff in ViewBag.Staff)
                            {
                                <option value="@staff.StaffId">Dr. @staff.FirstName @staff.LastName</option>
                            }
                        </select>
                        <span asp-validation-for="StaffId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Appointment Date & Time</label>
                        <input asp-for="AppointmentDate" type="datetime-local" class="form-control" required
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Reason for Visit</label>
                        <input asp-for="Reason" class="form-control" placeholder="e.g., Vaccination, Checkup" required />
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Additional Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any specific concerns?"></textarea>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="/ClientPortal" class="btn btn-secondary">Back to Portal</a>
                    <button type="submit" class="btn btn-success px-5">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}