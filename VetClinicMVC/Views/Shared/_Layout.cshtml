<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetCare Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .navbar-brand { font-size: 1.5rem; }
        .nav-link i { margin-right: 5px; }
        .badge-notification { font-size: 0.7rem; vertical-align: top; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold">🐾 VetCare Clinic</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ClientPortal" asp-action="Index">
                                    <i class="fas fa-home"></i> My Portal
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ClientPortal" asp-action="Book">
                                    <i class="fas fa-calendar-plus"></i> Book Visit
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ClientPortal" asp-action="MyAppointments">
                                    <i class="fas fa-calendar-alt"></i> My Appointments
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link fw-bold text-warning" href="/Staff/ManageAppointments"><i class="fas fa-stethoscope"></i> VET QUEUE</a></li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-paw"></i> Management
                                </a>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item" href="/Client">Clients</a></li>
                                    <li><a class="dropdown-item" href="/Pet">Pets</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Staff">Staff Members</a></li>
                                </ul>
                            </li>

                            <li class="nav-item"><a class="nav-link" href="/Appointment"><i class="fas fa-calendar-alt"></i> All Appointments</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Visit"><i class="fas fa-notes-medical"></i> Medical Records</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Inventory"><i class="fas fa-pills"></i> Inventory</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Billing"><i class="fas fa-file-invoice-dollar"></i> Billing</a></li>
                        }
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle btn btn-outline-light ms-lg-2 text-white" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Identity/Account/Manage">My Profile</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item text-danger">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Identity/Account/Login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-warning ms-lg-2" href="/Identity/Account/Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4 pb-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-success border-4">
                <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 border-start border-danger border-4">
                <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="footer mt-auto py-3 bg-light border-top text-center">
        <div class="container">
            <span class="text-muted">© @DateTime.Now.Year - VetCare Clinic Management System</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>