@model VetClinicMVC.Models.Appointment
@{
    ViewData["Title"] = "Book Appointment";
}

<h2>📅 Book New Appointment</h2>

<form asp-action="Create" asp-controller="Appointment" method="post">
    <div class="mb-3">
        <label class="form-label">Select Pet</label>
        <select asp-for="PetId" class="form-select" required>
            <option value="">-- Choose your pet --</option>
            @foreach (var pet in (IEnumerable<VetClinicMVC.Models.Pet>)ViewBag.MyPets ?? Enumerable.Empty<VetClinicMVC.Models.Pet>())
            {
                <option value="@pet.PetId">@pet.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Preferred Date & Time</label>
        <input asp-for="AppointmentDate" class="form-control" type="datetime-local" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Reason for Visit</label>
        <textarea asp-for="Reason" class="form-control" rows="3" required></textarea>
    </div>

    <button type="submit" class="btn btn-success btn-lg">Request Appointment</button>
    <a href="/ClientPortal" class="btn btn-secondary">Cancel</a>
</form>