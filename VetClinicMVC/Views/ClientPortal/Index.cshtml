@model VetClinicMVC.Models.Client
@{
    ViewData["Title"] = "My Portal";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border-start border-primary border-5">
    <div class="container-fluid py-2">
        <h1 class="display-5 fw-bold">🐾 Hello, @Model.FirstName!</h1>
        <p class="col-md-8 fs-4 text-muted">Welcome to your pet care dashboard. Manage your furry friends and schedule visits all in one place.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-primary bg-gradient text-white mb-3 rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-github fs-3"></i>
                </div>
                <h5 class="text-uppercase text-muted fw-bold small">My Family</h5>
                <h2 class="display-4 fw-bold">@(ViewBag.MyPets != null ? ((IEnumerable<VetClinicMVC.Models.Pet>)ViewBag.MyPets).Count() : 0)</h2>
                <p class="text-muted">Registered Pets</p>
                <div class="d-grid mt-3">
                    <a asp-controller="ClientPortal" asp-action="MyPets" class="btn btn-primary btn-lg">Manage Pets</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 border-top border-success border-4 hover-shadow transition">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-success bg-gradient text-white mb-3 rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-calendar-plus fs-3"></i>
                </div>
                <h5 class="text-uppercase text-muted fw-bold small">New Visit</h5>
                <h3 class="py-3">Need a Vet?</h3>
                <p class="text-muted">Schedule a checkup or vaccination for your pets.</p>
                <div class="d-grid mt-3">
                    <a asp-controller="Appointment" asp-action="Book" class="btn btn-success btn-lg">Book Now</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition">
            <div class="card-body text-center p-4">
                <div class="feature-icon bg-info bg-gradient text-white mb-3 rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
                <h5 class="text-uppercase text-muted fw-bold small">Schedules</h5>
                <h2 class="display-4 fw-bold">@(ViewBag.MyAppointments != null ? ((IEnumerable<VetClinicMVC.Models.Appointment>)ViewBag.MyAppointments).Count() : 0)</h2>
                <p class="text-muted">Total Bookings</p>
                <div class="d-grid mt-3">
                    <a asp-controller="ClientPortal" asp-action="MyAppointments" class="btn btn-outline-primary btn-lg">
                        History & Status
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .transition {
        transition: all 0.3s ease-in-out;
    }
</style>