@model VetClinicMVC.Models.Client
@{
    ViewData["Title"] = "My Portal";
}

<h2 class="mb-4">🐾 Welcome, @Model.FirstName!</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h5>My Pets</h5>
                <h3>@(ViewBag.MyPets != null ? ((IEnumerable<VetClinicMVC.Models.Pet>)ViewBag.MyPets).Count() : 0)</h3>
                <a asp-controller="Pet" asp-action="Index" class="btn btn-primary">Manage Pets</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h5>Book Appointment</h5>
                <a asp-controller="Appointment" asp-action="Book" class="btn btn-success mt-3">Book Now</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body text-center">
                <h5>My Appointments</h5>
                <h3>@(ViewBag.MyAppointments != null ? ((IEnumerable<VetClinicMVC.Models.Appointment>)ViewBag.MyAppointments).Count() : 0)</h3>
                <a asp-controller="Appointment" asp-action="Index" class="btn btn-info mt-3">View All</a>
            </div>
        </div>
    </div>
</div>