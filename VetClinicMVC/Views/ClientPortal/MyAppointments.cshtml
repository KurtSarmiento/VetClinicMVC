@model IEnumerable<VetClinicMVC.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📅 My Appointment History</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Pet Name</th>
                        <th>Veterinarian</th>
                        <th>Date & Time</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Billing</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Pet?.Name</td>
                            <td>Dr. @item.Staff?.LastName</td>
                            <td>@item.AppointmentDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                            <td>@item.Reason</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-primary">Pending</span>
                                }
                                else if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-primary">Confirmed</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>Check <a asp-action="MyBills">My Bills</a></td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                You have no appointments scheduled.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
