@model IEnumerable<VetClinicMVC.Models.Appointment>
@{
    ViewData["Title"] = "My Appointments";
}

<h2 class="mb-4">📅 My Appointments</h2>

<a href="/ClientPortal/BookAppointment" class="btn btn-success mb-3">+ Book New Appointment</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Date & Time</th>
            <th>Pet</th>
            <th>Veterinarian</th>
            <th>Reason</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appt in Model)
        {
            <tr>
                <td>@appt.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                <td>@appt.Pet?.Name</td>
                <td>@appt.Staff?.FirstName @appt.Staff?.LastName</td>
                <td>@appt.Reason</td>
                <td>
                    <span class="badge bg-@(appt.Status == "Confirmed" ? "success" : appt.Status == "Cancelled" ? "danger" : "info")">
                        @appt.Status
                    </span>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        You don't have any appointments yet. <a href="/ClientPortal/BookAppointment">Book one now!</a>
    </div>
}