@model VetClinicMVC.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="jumbotron bg-light py-4 mb-4">
    <h2>Welcome to Your Pet Portal, @User.Identity?.Name!</h2>
    <p class="lead">Manage your pets and book appointments easily.</p>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-primary">
            <div class="card-body text-center">
                <h5>My Pets</h5>
                <h3>3</h3> <!-- Will be dynamic later -->
                <a href="/Pet" class="btn btn-primary mt-3">View My Pets</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success">
            <div class="card-body text-center">
                <h5>Upcoming Appointments</h5>
                <h3>@Model.UpcomingAppointments.Count()</h3>
                <a href="/Appointment" class="btn btn-success mt-3">Book New Appointment</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-body text-center">
                <h5>Medical Records</h5>
                <h3>12</h3>
                <a href="#" class="btn btn-warning mt-3">View Records</a>
            </div>
        </div>
    </div>
</div>

<h4>Upcoming Appointments</h4>
<!-- Same table as above but filtered for current client later -->