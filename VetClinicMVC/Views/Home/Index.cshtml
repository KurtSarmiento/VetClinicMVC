@{
    ViewData["Title"] = "VetClinic Portal";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold text-primary">🐾 PawCare Veterinary Clinic</h1>
        <p class="lead text-muted">A full-service medical center for your best friends.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-5">
            <div class="card h-100 shadow border-0 text-center p-4">
                <div class="card-body">
                    <div class="display-1 mb-3 text-success">
                        <i class="bi bi-person-heart"></i>
                    </div>
                    <h2 class="fw-bold">Pet Owner Portal</h2>
                    <p class="text-muted mb-4">Book appointments, manage your pets, and view medical history.</p>
                    <div class="d-grid">
                        <a asp-controller="ClientPortal" asp-action="Index" class="btn btn-success btn-lg">Enter Client Portal</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow border-0 text-center p-4">
                <div class="card-body">
                    <div class="display-1 mb-3 text-primary">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h2 class="fw-bold">Staff Console</h2>
                    <p class="text-muted mb-4">Manage the daily queue, confirm bookings, and record medical visits.</p>
                    <div class="d-grid">
                        <a asp-controller="Staff" asp-action="ManageAppointments" class="btn btn-primary btn-lg">Access Staff Dashboard</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 text-center p-4 bg-light rounded shadow-sm">
        <h5 class="fw-bold">Demo Quick-Start Guide ⏱️</h5>
        <div class="row text-start mt-3">
            <div class="col-md-4">
                <strong>1. Book:</strong> Enter Client Portal -> Book Appointment (Pick 10am-5pm).
            </div>
            <div class="col-md-4">
                <strong>2. Confirm:</strong> Enter Staff Console -> Approve the request.
            </div>
            <div class="col-md-4">
                <strong>3. Visit:</strong> Staff Console -> Check-in -> Enter Weight/Diagnosis -> Complete.
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: scale(1.02);
        }
</style>