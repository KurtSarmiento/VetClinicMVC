@{
    ViewData["Title"] = "VetCare Clinic - Angeles City";
}

<!-- Hero Section -->
<section class="bg-primary text-white py-5 text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">🐾 Welcome to VetCare Clinic</h1>
        <p class="lead">Compassionate veterinary care for your beloved pets in Angeles City</p>
        <a href="/Identity/Account/Login" class="btn btn-light btn-lg mt-3">Book an Appointment</a>
        <a href="/Home/Services" class="btn btn-outline-light btn-lg mt-3 ms-3">Our Services</a>
    </div>
</section>

<!-- About Us -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2>About VetCare Clinic</h2>
                <p>We are a full-service veterinary clinic dedicated to providing high-quality medical care for dogs, cats, and other pets. Our experienced veterinarians and friendly staff ensure your pet receives the best treatment possible.</p>
                <ul>
                    <li>24/7 Emergency Care</li>
                    <li>Vaccinations & Preventive Care</li>
                    <li>Surgery & Dental Services</li>
                    <li>Laboratory & Diagnostic Imaging</li>
                </ul>
            </div>
            <div class="col-md-6 text-center">
                <img src="https://via.placeholder.com/600x400?text=Vet+Clinic" class="img-fluid rounded" alt="Clinic" />
            </div>
        </div>
    </div>
</section>

<!-- Services Preview -->
<section class="bg-light py-5">
    <div class="container">
        <h2 class="text-center mb-4">Our Services</h2>
        <div class="row text-center">
            <div class="col-md-4">
                <h5>General Check-up</h5>
                <p>Comprehensive health examinations</p>
            </div>
            <div class="col-md-4">
                <h5>Vaccinations</h5>
                <p>Protect your pet from diseases</p>
            </div>
            <div class="col-md-4">
                <h5>Surgery</h5>
                <p>Spay, Neuter & Emergency Surgery</p>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="/Home/Services" class="btn btn-primary">View All Services</a>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 text-center bg-success text-white">
    <div class="container">
        <h3>Ready to book an appointment?</h3>
        <a href="/Identity/Account/Login" class="btn btn-light btn-lg">Login / Register Now</a>
    </div>
</section>