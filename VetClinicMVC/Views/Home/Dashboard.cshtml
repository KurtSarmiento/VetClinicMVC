@model VetClinicMVC.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="jumbotron bg-light py-4 mb-4">
    <h2 class="mb-0">🐾 Welcome back, @User.Identity?.Name!</h2>
    <p class="lead">VetCare Clinic Management System</p>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body">
                <h5>Total Clients</h5>
                <h2>@Model.TotalClients</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success h-100">
            <div class="card-body">
                <h5>Total Pets</h5>
                <h2>@Model.TotalPets</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning h-100">
            <div class="card-body">
                <h5>Upcoming Appointments</h5>
                <h2>@Model.UpcomingAppointments.Count()</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info h-100">
            <div class="card-body">
                <h5>Today's Visits</h5>
                <h2>0</h2> <!-- You can enhance this later -->
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Upcoming Appointments</h4>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Date & Time</th>
            <th>Pet</th>
            <th>Owner</th>
            <th>Staff</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appt in Model.UpcomingAppointments.Take(8))
        {
            <tr>
                <td>@appt.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                <td>@appt.Pet?.Name</td>
                <td>@appt.Client?.FirstName @appt.Client?.LastName</td>
                <td>@appt.Staff?.FirstName</td>
                <td><span class="badge bg-info">@appt.Status</span></td>
                <td>
                    <a href="/Appointment/Details/@appt.AppointmentId" class="btn btn-sm btn-primary">View</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a href="/Appointment" class="btn btn-success">Manage All Appointments</a>
    <a href="/Client" class="btn btn-primary">Manage Clients</a>
    <a href="/Pet" class="btn btn-info">Manage Pets</a>
</div>