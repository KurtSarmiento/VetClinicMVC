@model VetClinicMVC.ViewModels.DashboardViewModel
@inject VetClinicMVC.Services.Interfaces.IUserLinkService UserLinkService
@{
    ViewData["Title"] = "Staff Dashboard";
    var staff = await UserLinkService.GetCurrentStaffAsync();
    var firstName = staff?.FirstName ?? User.Identity?.Name;
}

<div class="staff-hero mb-4">
    <div>
        <p class="text-uppercase fw-semibold mb-2">Staff Dashboard</p>
        <h2 class="mb-2">Welcome back, @firstName!</h2>
        <p class="mb-0">Track today’s queue, client activity, and patient care from one calm workspace.</p>
    </div>
    <a asp-controller="Staff" asp-action="ManageAppointments" class="btn btn-light">Open Queue</a>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5>Total Clients</h5>
                <h2>@Model.TotalClients</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5>Total Pets</h5>
                <h2>@Model.TotalPets</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5>Upcoming Appointments</h5>
                <h2>@Model.UpcomingAppointments.Count()</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <h5>Today's Visits</h5>
                <h2>0</h2> <!-- You can enhance this later -->
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 mb-3">
    <h4 class="mb-0">Upcoming Appointments</h4>
    <a asp-controller="Staff" asp-action="ManageAppointments" class="btn btn-sm btn-primary">Open Queue</a>
</div>

<div class="card shadow-sm app-card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date & Time</th>
                    <th>Pet</th>
                    <th>Owner</th>
                    <th>Staff</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model.UpcomingAppointments.Take(8))
                {
                    <tr>
                        <td>@appt.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>@appt.Pet?.Name</td>
                        <td>@appt.Client?.FirstName @appt.Client?.LastName</td>
                        <td>Dr. @appt.Staff?.FirstName @appt.Staff?.LastName</td>
                        <td><span class="badge bg-primary">@appt.Status</span></td>
                        <td class="text-end">
                            <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-outline-primary">View</a>
                            @if (appt.Status == "Confirmed")
                            {
                                <a asp-controller="Staff" asp-action="CheckIn" asp-route-id="@appt.AppointmentId" class="btn btn-sm btn-primary">Check-in</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Staff" asp-action="ManageAppointments" class="btn btn-primary">Manage Appointments</a>
    <a asp-controller="Client" asp-action="Index" class="btn btn-primary">Manage Clients</a>
    <a asp-controller="Pet" asp-action="Index" class="btn btn-primary">Manage Pets</a>
    <a asp-controller="Staff" asp-action="Index" class="btn btn-outline-secondary">Manage Staff</a>
</div>
